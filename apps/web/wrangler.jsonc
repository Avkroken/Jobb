{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jobb",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    { "binding": "DB", "database_name": "jobb" }
  ],
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "jobb-evidence" }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "workflows": [
    {
      "name": "jobb-automation",
      "binding": "JOB_AUTOMATION",
      "class_name": "JobAutomationWorkflow"
    }
  ],
  "triggers": {
    "crons": ["0 8-19 14 * *"]
  }
}
